configuration {
  kb-row-up: "Control+e";
  kb-row-down: "Control+n,Tab";
  kb-accept-entry: "control+i,Alt_L,Return";
  kb-element-next: "";
  kb-remove-to-eol: "";
  kb-mode-complete: "";
  kb-move-end: "";

  display-drun: "What today Boss?";
  display-window: "Windows";
  drun-display-format: "{icon} {name}";
  modi: "window,run,drun";
  show-icons: true;
}

//@theme "/home/toast/.config/rofi/mainTheme.rasi"

@theme "/usr/share/rofi/themes/Arc-Dark.rasi"
